load-test-results/

# ── Docs build artefacts ──────────────────────────────
*.pdf.tmp
~$*.docx
~$*.pptx

# ── Python / uv ───────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.env

# Generated from the .proto at build time — regenerate with `make proto`,
# never commit. The contract is proto/, not the stubs.
services/*/src/*/gen/

# Generated by docs/build-*-docx.py — rebuild, do not commit.
docs/HireAssist-*.docx
