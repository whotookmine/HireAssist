{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/changelog-reminder.sh\"",
            "timeout": 10,
            "statusMessage": "Checking changelog"
          }
        ]
      }
    ]
  }
}
