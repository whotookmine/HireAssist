@startuml architecture-diagram
' HireAssist — Architecture Diagram, version 1 (Microservice Design with Collaborations)
'
' This file is the source of the diagram. architecture-diagram.svg next to it is rendered from it
' and embedded in docs/ARCHITECTURE.md. After editing, re-render and commit both files together:
'
'   plantuml -tsvg docs/diagrams/architecture-diagram.puml
'   (or: java -jar plantuml.jar -tsvg docs/diagrams/architecture-diagram.puml — needs Graphviz)
'
' It must agree with the Service–Operations–Collaborators table (docs/SERVICE-OPERATIONS-COLLABORATORS.md)
' and with ADR-001 (service boundaries), ADR-002 (screening queue), ADR-003 (data stores),
' ADR-004 (model access) and ADR-006 (one deployment per customer).
'
' Arrow convention (set by the course): A --> B means "A calls B". Responses are not drawn.
' A plain line between a service and a data store means "this service owns this store".
' Layout hints: [hidden] and [norank] edges only shape the picture; they carry no meaning.

left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam arrowFontSize 10
skinparam arrowColor #333333
skinparam actorBorderColor #333333
skinparam actorBackgroundColor #FFFFFF
skinparam rectangleBorderColor #333333
skinparam databaseBorderColor #333333
skinparam databaseBackgroundColor #EADCF0
skinparam queueBorderColor #333333
skinparam queueBackgroundColor #FFF4D6
skinparam cloudBorderColor #333333
skinparam cloudBackgroundColor #E6F2E6
skinparam packageBorderColor #999999
skinparam packageBackgroundColor #FFFFFF
skinparam nodesep 45
skinparam ranksep 120

' ── Actors: people, and the timer that initiates scheduled work ──────────────────────
actor "Recruiter" as R
actor "Admin" as AD
actor "System Scheduler\n(timer)" as SCH
R <|-- AD

rectangle "Recruiter Web UI\n(browser)" as UI #FAFAFA

' ── One deployment serves one customer company (ADR-006) ─────────────────────────────
package "HireAssist — one deployment per customer company" {

  rectangle "**API Gateway**\nREST · TLS · session check\nrate limit · routing" as GW #DDEEF5

  rectangle "**Identity Service**\nREST API · UC-0, UC-6" as IDS #DDEEF5
  rectangle "**Hiring Service**\nREST API · UC-1, UC-2, UC-3" as HS #DDEEF5
  rectangle "**Resume Processing Service**\nqueue consumer · UC-2, per resume" as RPS #DDEEF5
  rectangle "**AI Service**\ngRPC API · no domain data" as AI #DDEEF5
  rectangle "**Compliance & Insights Service**\nREST API · UC-4, UC-5" as CIS #DDEEF5

  database "PostgreSQL\nusers · roles · sessions" as IDB
  database "PostgreSQL\njob openings · criteria · batches\nscreening results · decisions\n──\nMongoDB · interview guides" as HDB
  database "MongoDB\ncandidate profiles · parsed text\nscoring evidence" as RDB
  database "PostgreSQL\nretention policy · pipeline metrics\nerasure audit log" as CDB

  queue "**RabbitMQ**\nmessage broker" as MQ

  ' ownership: a service and its private store
  IDS -- IDB
  HS -- HDB
  RPS -- RDB
  CIS -- CDB
}

' ── External systems, each reached through an adapter inside the calling service ─────
package "External systems" {
  cloud "LLM Provider\n(Anthropic Claude API)" as LLM
  cloud "Object Storage\n(S3-compatible · MinIO)\nresume files" as OBJ
  cloud "Email Provider\n(SMTP / SES)" as MAIL
}

' ── Who calls whom ─────────────────────────────────────────────────────────────────────
R --> UI
AD --> UI
UI --> GW : REST

GW --> IDS : sign in · validateSession()\nmembers & roles
GW --> HS : job openings · batches\nresults · interview guides
GW --> CIS : dashboard · retention policy
GW -[hidden]-> RPS
GW -[hidden]-> AI

' service-to-service calls (norank: kept in one column of services)
HS -[norank]-> AI : gRPC · deriveCriteriaFromDescription(),\ngenerateInterviewQuestions()
HS -[norank]-> RPS : \n\n\ngetCandidateProfile() · REST
RPS -[norank]-> HS : getScreeningCriteria() · REST\n\n\n
RPS -[norank]-> AI : gRPC · extractProfileFields(),\nscoreAgainstCriteria()
CIS -[norank]-> HS : REST · getJobOpening(), eraseHiringData()
CIS -[norank]-> RPS : REST · listCandidateProfiles(),\neraseCandidateProfile()

' messaging
IDS --> MQ : publish AuthorisationRejected
HS --> MQ : publish ResumeSubmitted, pipeline events\nconsume ResumeScored
RPS --> MQ : consume ResumeSubmitted\npublish ResumeScored
CIS --> MQ : consume pipeline events,\nAuthorisationRejected

' external systems, via adapters
HS --> OBJ : Object Storage Adapter\nstoreResumeFile()
RPS --> OBJ : Object Storage Adapter\nfetchResumeFile()
AI --> LLM : LLM Adapter · complete()
HS --> MAIL : Email Adapter · sendEmail()\n(batch finished)
CIS --> MAIL : Email Adapter · sendEmail()\n(stale position, retention warning)

SCH --> CIS : evaluateStaleness()\nevaluateRetention()

@enduml
